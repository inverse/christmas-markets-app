{
  "name": "christmas-markets",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate-markets": "tsx scripts/generate-markets.ts",
    "dev": "vite dev",
    "dev:tunnel": "concurrently \"npm run dev\" \"node scripts/dev-tunnel-qr.mjs\"",
    "build": "vite build",
    "publish:web": "npm run build && npx wrangler pages deploy",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,ts,svelte,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "qrcode-terminal": "^0.12.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "leaflet": "^1.9.4"
  }
}
